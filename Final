    {
      "parameters": {
        "jsCode": "const c = $('W5 Input').first().json; const g = $('Judge Gate').first().json; const cfg = g.cfg;\nconst allowed = String(cfg.allowed_email_domains || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst ok = e => { const m = String(e || '').trim().toLowerCase().match(/^[^@\\s]+@([^@\\s]+)$/); return !!(m && allowed.includes(m[1])); };\nlet to = String(c.clinician_email || '').trim().toLowerCase(); const flags = [...g.review_flags];\nif (!ok(to)) { flags.push('CLINICIAN_EMAIL_NOT_ALLOWED'); to = String(cfg.evaluation_owner_email || '').trim().toLowerCase(); }\nif (!ok(to)) throw new Error('No allowed recipient for sign-off (check Clinicians and Config.allowed_email_domains)');\nconst esc = t => String(t ?? '').replace(/[&<>\"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\nconst nl = t => esc(t).replace(/\\n/g, '<br>');\nconst risk = { HIGH: '#b00020', MEDIUM: '#b26a00', LOW: '#1b7f3b' }[c.denial_risk] || '#555';\nconst checklist = c.best_claim_services.map((s, i) => `<tr><td>${i + 1}</td><td>${esc(s.service_code || '—')}</td><td>${esc(s.service_name)}</td><td>${esc(s.necessity)}</td><td>${s.decision === 'INCLUDE_BILLED' ? 'Billed ✓' : '<b>Not billed – verify</b>'}</td><td style=\"font-size:11px\">${esc(s.ref)}</td></tr>`).join('') || '<tr><td colspan=\"6\">No approved protocol matched – manual coding review.</td></tr>';\nconst gaps = c.gaps.map(x => `<tr><td>${esc(x.type)}</td><td>${esc(x.service_code)}</td><td>${esc(x.description)}</td><td style=\"text-align:right\">${Number(x.value).toFixed(2)}</td><td style=\"font-size:11px\">${esc(x.reason)}</td></tr>`).join('') || '<tr><td colspan=\"5\">No gaps found.</td></tr>';\nconst scores = g.scores.map(s => `${s.target}: safety ${s.safety_compliance}/5 · grounded ${s.groundedness}/5 · avg ${s.average}`).join('<br>') || 'Judge did not return scores – review with extra care.';\nconst L = c.letter && c.letter.letter_en ? `<h4>Draft ${esc(c.letter.letter_type)} – ${esc(c.letter.subject)}</h4><div style=\"background:#f6f7f9;padding:10px;border-radius:6px\">${nl(c.letter.letter_en)}</div><div dir=\"rtl\" style=\"background:#f6f7f9;padding:10px;border-radius:6px;margin-top:8px;text-align:right\">${nl(c.letter.letter_ar)}</div>` : '';\nconst t = c.totals;\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:760px;color:#1d2433\">\n<h2 style=\"margin:0\">Clinician review required · ${esc(c.claim_ref)}</h2>\n<p style=\"color:#555;margin:4px 0 14px\">Patient token <b>${esc(c.patient_token)}</b> – no patient identifiers in this email.</p>\n<table cellpadding=\"6\" style=\"border-collapse:collapse;width:100%;background:#f6f7f9\"><tr><td><b>Diagnosis</b><br>${esc(c.principal_dx_code)} ${esc(c.principal_dx_desc)}</td><td><b>Protocol</b><br>${esc(c.matched_protocol_id)} ${esc(c.matched_protocol_title)}</td><td><b>Denial risk</b><br><span style=\"color:${risk};font-weight:bold\">${esc(c.denial_risk)}</span></td></tr>\n<tr><td><b>Billed</b><br>${t.billed_total} EGP</td><td><b>Possibly unbilled (mandatory)</b><br>${t.missing_value} EGP</td><td><b>At risk of denial</b><br>${(t.extra_value_at_risk + t.price_variance_total).toFixed(2)} EGP</td></tr></table>\n<p>${nl(c.gap_narrative_en)}</p>\n<h4>Best Procedure checklist</h4><table border=\"1\" cellpadding=\"5\" style=\"border-collapse:collapse;width:100%;font-size:13px\"><tr style=\"background:#1f3864;color:#fff\"><th>#</th><th>Code</th><th>Service</th><th>Necessity</th><th>Status</th><th>Protocol ref</th></tr>${checklist}</table>\n<h4>Gaps</h4><table border=\"1\" cellpadding=\"5\" style=\"border-collapse:collapse;width:100%;font-size:13px\"><tr style=\"background:#1f3864;color:#fff\"><th>Type</th><th>Code</th><th>Item</th><th>EGP</th><th>Reason</th></tr>${gaps}</table>\n${L}\n<p style=\"font-size:12px;color:#555\"><b>Automated quality check (LLM-as-judge):</b><br>${scores}<br><b>Flags:</b> ${esc(flags.join(', ') || 'none')}</p>\n<p style=\"margin:22px 0\"><a href=\"%%RESUME_URL%%\" style=\"background:#1f3864;color:#fff;padding:12px 18px;border-radius:6px;text-decoration:none\"><b>Open secure sign-off form / فتح نموذج الاعتماد</b></a></p>\n<hr><div dir=\"rtl\" style=\"text-align:right\"><h3>مطلوب مراجعة الطبيب · ${esc(c.claim_ref)}</h3><p>${nl(c.gap_narrative_ar)}</p></div>\n<p style=\"color:#777;font-size:12px\">Administrative and educational support only – the final clinical and coding decision rests with the physician. / للدعم الإداري فقط، والقرار الطبي النهائي للطبيب.</p></div>`;\nreturn [{ json: { to, subject: `[Action required / مطلوب إجراء] Claim review ${c.claim_ref} – risk ${c.denial_risk}`, html, review_flags: flags } }];\n"
      },
