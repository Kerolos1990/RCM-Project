      "parameters": {
        "jsCode": "// Deterministic validation of the agent output. Codes/prices come ONLY from the guideline tables, never from the model.\nconst src = $('Retrieve Candidate Protocols').all().map(i => i.json);\nconst res = $input.all().map(i => i.json);\nconst INFO = new Set(['PROTOCOL_PENDING_VALIDATION', 'MANDATORY_AUTO_ADDED']);\nreturn src.map((c, idx) => {\n  const r = res[idx] || {};\n  const o = r.output || {};\n  const flags = [];\n  if (!r.output) flags.push('LLM_FAILED');\n  if (o.claim_ref && o.claim_ref !== c.claim_ref) flags.push('CLAIM_REF_MISMATCH');\n  let prot = c.candidates.find(p => p.protocol_id === o.matched_protocol_id);\n  let matched = !!(o.protocol_match_found && prot);\n  if (o.protocol_match_found && !prot) flags.push('PROTOCOL_NOT_IN_RETRIEVED_SET');\n  if (!c.candidates.length) matched = false;\n  if (!matched) { flags.push('NO_PROTOCOL_MATCH'); prot = null; }\n  const best = [];\n  if (prot) {\n    const rows = Object.fromEntries(prot.services.map(s => [String(s.row_id), s]));\n    const seen = new Set();\n    for (const sel of (o.selected_services || [])) {\n      const s = rows[String(sel.row_id)];\n      if (!s) { flags.push('INVALID_ROW_ID:' + sel.row_id); continue; }\n      if (seen.has(s.row_id)) continue; seen.add(s.row_id);\n      best.push({ ...s, decision: s.billed ? 'INCLUDE_BILLED' : 'INCLUDE_NOT_BILLED_REVIEW', reason: String(sel.reason || '') });\n    }\n    for (const s of prot.services) if (s.necessity === 'mandatory' && !seen.has(s.row_id)) {\n      seen.add(s.row_id); flags.push('MANDATORY_AUTO_ADDED');\n      best.push({ ...s, decision: s.billed ? 'INCLUDE_BILLED' : 'INCLUDE_NOT_BILLED_REVIEW', reason: 'Mandatory in the approved protocol (added by validation rule)' });\n    }\n    if (best.some(s => s.service_code && /low|none/i.test(s.mapping_confidence))) flags.push('LOW_CONFIDENCE_CODE_MAPPING');\n    if (/pending/i.test(prot.validation_status || '')) flags.push('PROTOCOL_PENDING_VALIDATION');\n  }\n  if (o.escalate_to_human) flags.push('ESCALATED_BY_AGENT');\n  const uniq = [...new Set(flags)];\n  const best_claim_services = best.map(s => ({\n    row_id: s.row_id, category: s.category, service_name: s.service_name, service_code: s.service_code, ichi_code: s.ichi_code,\n    necessity: s.necessity, condition: s.condition, negative_statement: s.negative_statement, tariff_price: Number(String(s.price_egp ?? '').replace(/,/g, '')) || 0,\n    mapping_confidence: s.mapping_confidence, billed: s.billed, decision: s.decision, reason: s.reason,\n    citation: { protocol_id: prot.protocol_id, document: prot.document_title, source_file: s.source_file, source_pages: s.source_pages, evidence_quote: s.evidence_quote }\n  }));\n  const { candidates, prompt, ...claim } = c;\n  return { json: { ...claim,\n    protocol_match_found: matched, matched_protocol_id: prot ? prot.protocol_id : 'NO_MATCH', matched_protocol_title: prot ? prot.diagnosis : '',\n    protocol_validation_status: prot ? (prot.validation_status || '') : '', match_rationale: String(o.match_rationale || ''),\n    clinical_justification: String(o.clinical_justification || (matched ? '' : 'No approved protocol matched this diagnosis - a clinician / certified coder must review manually.')),\n    escalation_reason: String(o.escalation_reason || ''),\n    best_claim_services, review_flags: uniq, needs_manual_review: uniq.some(f => !INFO.has(f)) } };\n});\n"
