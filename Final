    {
      "parameters": {
        "jsCode": "// Post-checks on every drafted letter: no identifiers, only provided citations, correct claim.\nconst src = $('Letters Needed').all().map(i => i.json);\nconst res = $input.all().map(i => i.json);\nconst LEAK = [/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/, /\\b\\d{9,}\\b/, /(?:\\+?20|0)?1[0125]\\d{8}\\b/];\nconst now = new Date().toISOString();\nreturn src.map((s, idx) => {\n  const r = res[idx] || {}; const o = r.output || {};\n  const flags = [];\n  let en = String(o.letter_en || ''), ar = String(o.letter_ar || '');\n  if (!r.output) { flags.push('LETTER_LLM_FAILED'); en = ''; ar = ''; }\n  if (o.claim_ref && o.claim_ref !== s.claim_ref) flags.push('LETTER_CLAIM_REF_MISMATCH');\n  if (LEAK.some(rx => rx.test(en + ' ' + ar))) { flags.push('LETTER_PHI_PATTERN_BLOCKED'); en = '[blocked - identifier pattern detected]'; ar = '[تم الحجب - تم رصد بيانات تعريفية]'; }\n  const refs = Array.isArray(o.cited_refs) ? o.cited_refs.map(String) : [];\n  const bad = refs.filter(x => !s.allowed_refs.includes(x));\n  if (bad.length) flags.push('LETTER_UNKNOWN_CITATION');\n  if (!refs.length && r.output) flags.push('LETTER_NO_CITATION');\n  return { json: { claim_ref: s.claim_ref, patient_token: s.patient_token, letter_type: s.letter_type, subject: String(o.subject || ''),\n    letter_en: en, letter_ar: ar, cited_refs: refs.join(' ; '), letter_flags: flags.join(';'), created_at: now } };\n});\n"
