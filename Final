      "parameters": {
        "jsCode": "// LangChain prompt templates treat curly braces as variables, so data is passed brace-free.\nconst braceSafe = s => String(s).replace(/\\{/g, '(').replace(/\\}/g, ')');\n// Deterministic gap & pricing engine (UHIA price list, 6th edition). The LLM never computes money.\nconst claims = $('W3 Input').all().map(i => i.json);\nconst pl = $('Read Price List').all().map(i => i.json).filter(p => p.service_code);\nconst byCode = new Map(), byIchi = new Map();\nfor (const p of pl) {\n  const rec = { code: String(p.service_code).trim(), ichi: String(p.ichi_code || '').trim(), name: p.name_en || p.name, price: Number(String(p.price ?? '').replace(/,/g, '')) || 0, deleted: /deleted/i.test(p.list_status || '') };\n  if (!byCode.has(rec.code) || byCode.get(rec.code).deleted) byCode.set(rec.code, rec);\n  if (rec.ichi && (!byIchi.has(rec.ichi) || byIchi.get(rec.ichi).deleted)) byIchi.set(rec.ichi, rec);\n}\nconst r2 = n => Math.round((Number(n) + Number.EPSILON) * 100) / 100;\nconst NEUTRAL = /accommodat|إقامة|اقامة|consult|examination|كشف|pharm|صيدل|anesth|تخدير/i;\nreturn claims.map(c => {\n  const gaps = [], info = [];\n  const lines = c.billed_services.map(s => {\n    const t = byCode.get(s.service_code) || byIchi.get(s.ichi_code) || null;\n    const tariff = t && !t.deleted ? t.price : null;\n    return { ...s, tariff_code: t ? t.code : '', tariff_unit: tariff, tariff_deleted: !!(t && t.deleted),\n      at_tariff: tariff !== null ? r2(tariff * s.qty) : null, variance: tariff !== null ? r2((s.unit_price - tariff) * s.qty) : null };\n  });\n  const protCodes = new Set(c.best_claim_services.map(s => s.service_code).filter(Boolean));\n  const negCodes = new Set(c.best_claim_services.filter(s => /yes/i.test(s.negative_statement)).map(s => s.service_code).filter(Boolean));\n  const billedKeys = new Set(lines.flatMap(l => [l.service_code, l.ichi_code, l.tariff_code]).filter(Boolean));\n  for (const s of c.best_claim_services) {\n    if (!s.service_code || s.billed || billedKeys.has(s.service_code) || billedKeys.has(s.ichi_code)) continue;\n    if (s.necessity === 'mandatory') gaps.push({ type: 'MISSING_MANDATORY', service_code: s.service_code, description: s.service_name, value: r2(s.tariff_price),\n      reason: `Mandatory in ${s.citation.protocol_id} (p.${s.citation.source_pages}) but not billed: confirm whether it was done and documented (unbilled revenue) or omitted (care gap).` });\n    else gaps.push({ type: 'MISSING_CONDITIONAL', service_code: s.service_code, description: s.service_name, value: r2(s.tariff_price),\n      reason: `${s.necessity} in ${s.citation.protocol_id}; condition: ${s.condition || 'not specified'} - bill only if performed and documented.` });\n  }\n  for (const l of lines) {\n    if (l.tariff_deleted) gaps.push({ type: 'DELETED_SERVICE_CODE', service_code: l.service_code, description: l.service_name, value: l.line_total, reason: 'Code is in the deleted list (5th edition) - will be rejected; recode.' });\n    if (l.tariff_unit === null) { info.push(l.service_code || l.service_name); continue; }\n    if (l.variance > 0.009) gaps.push({ type: 'PRICE_ABOVE_TARIFF', service_code: l.service_code, description: l.service_name, value: l.variance, reason: `Billed ${l.unit_price} per unit vs UHIA tariff ${l.tariff_unit} - likely payer cut.` });\n    if (l.variance < -0.009) gaps.push({ type: 'PRICE_BELOW_TARIFF', service_code: l.service_code, description: l.service_name, value: Math.abs(l.variance), reason: `Billed ${l.unit_price} per unit vs tariff ${l.tariff_unit} - possible under-billing.` });\n    if (!c.protocol_match_found) continue;\n    const code = l.tariff_code || l.service_code;\n    if (negCodes.has(code)) gaps.push({ type: 'NOT_ROUTINE_PER_PROTOCOL', service_code: code, description: l.service_name, value: l.line_total, reason: 'Protocol states this item is not routinely indicated / restricted - needs documented justification (utilisation review).' });\n    else if (!protCodes.has(code) && !NEUTRAL.test(l.service_group + ' ' + l.service_name)) gaps.push({ type: 'EXTRA_NOT_IN_PROTOCOL', service_code: code, description: l.service_name, value: l.line_total, reason: 'Not listed in the matched protocol - denial risk unless the clinical note justifies it.' });\n  }\n  if (!c.protocol_match_found) gaps.push({ type: 'NO_PROTOCOL_MATCH', service_code: '', description: c.principal_dx_desc, value: 0, reason: 'No approved protocol matched - manual coding review required.' });\n  const sum = t => r2(gaps.filter(g => t.includes(g.type)).reduce((a, g) => a + g.value, 0));\n  const billed_at_tariff = r2(lines.reduce((a, l) => a + (l.at_tariff ?? 0), 0));\n  const best_claim_total = r2(c.best_claim_services.filter(s => s.service_code).reduce((a, s) => {\n    const l = lines.find(x => x.service_code === s.service_code || x.tariff_code === s.service_code); return a + (l && l.at_tariff !== null ? l.at_tariff : s.tariff_price); }, 0));\n  const missing_value = sum(['MISSING_MANDATORY']);\n  const extra_value_at_risk = sum(['EXTRA_NOT_IN_PROTOCOL', 'NOT_ROUTINE_PER_PROTOCOL', 'DELETED_SERVICE_CODE']);\n  const price_variance_total = sum(['PRICE_ABOVE_TARIFF']);\n  const types = new Set(gaps.map(g => g.type));\n  const denial_risk = (types.has('PRICE_ABOVE_TARIFF') || types.has('NOT_ROUTINE_PER_PROTOCOL') || types.has('DELETED_SERVICE_CODE') || types.has('NO_PROTOCOL_MATCH') || (c.denial_reason && missing_value > 0)) ? 'HIGH'\n    : (types.has('EXTRA_NOT_IN_PROTOCOL') || types.has('MISSING_MANDATORY')) ? 'MEDIUM' : 'LOW';\n  const totals = { billed_total: c.billed_total, billed_at_tariff, best_claim_total, missing_value, extra_value_at_risk, price_variance_total };\n  const prompt = braceSafe(`<claim>\\nclaim_ref: ${c.claim_ref}\\npatient_token: ${c.patient_token}\\nprincipal diagnosis: ${c.principal_dx_code} ${c.principal_dx_desc}\\nmatched protocol: ${c.matched_protocol_id} ${c.matched_protocol_title}\\ndenial reason (if any): ${c.denial_reason || 'none'}\\n</claim>\\n<totals_EGP>\\n${JSON.stringify(totals)}\\n</totals_EGP>\\n<gaps>\\n${JSON.stringify(gaps)}\\n</gaps>\\n<denial_risk>${denial_risk}</denial_risk>`);\n  return { json: { ...c, priced_lines: lines, unpriced_items: info, gaps, totals, denial_risk, prompt } };\n});\n"
