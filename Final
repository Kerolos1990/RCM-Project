      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst KEY = Buffer.from('3cbe8bf146809265499ee330fac14995846606efbaaec5de63f5c81b9d23a20b', 'hex');\nconst HMAC_SECRET = 'your_hmac_secret_key_here_at_least_16_chars';\nconst src = $('Collect Raw Rows').first().json;\nconst cfg = $('Pause Check').first().json.cfg || {};\nconst clin = {};\nfor (const i of $('Read Clinicians').all()) {\n  const id = String(i.json.practitioner_id ?? '').trim();\n  if (id) clin[id] = String(i.json.email ?? '').trim().toLowerCase();\n}\nconst AR = '٠١٢٣٤٥٦٧٨٩', FA = '۰۱۲۳۴۵۶۷۸۹';\nconst latin = s => String(s ?? '').replace(/[٠-٩]/g, d => AR.indexOf(d)).replace(/[۰-۹]/g, d => FA.indexOf(d));\nconst idStr = v => { let s = latin(v).trim(); if (/^\\d+\\.0+$/.test(s)) s = s.replace(/\\.0+$/, ''); return s; };\nconst norm = k => String(k).replace(/^﻿/, '').toLowerCase().replace(/[^a-z0-9]+/g, '');\nconst ALIAS = {\n  facility_id: ['facilityid'], facility: ['facilityname', 'facility'], patient_file_no: ['patientid', 'mrn', 'patientfileno'],\n  patient_name: ['patientname'], national_id: ['nationalid', 'nid'], encounter_type: ['encountertype'], episode_id: ['episodeid'],\n  visit_id: ['visitid'], encounter_id: ['encounterid'], visit_type: ['visittype'], dx_codes: ['diagnosiscode'],\n  dx_descs: ['diagnosisdescription'], dx_types: ['diagnosistype'], bill_no: ['billno'], bill_date: ['billdate'],\n  qty: ['procedureqty', 'qty', 'quantity'], practitioner_id: ['attendpractitionerid'], practitioner_name: ['attendpractitionername'],\n  service_group: ['servicegroupdescription'], service_class: ['serclassname'], service_code: ['servicecod', 'servicecode'],\n  service_name: ['sernameen', 'servicename'], service_name_ar: ['sernamear'], ichi_code: ['ichiorloinccode', 'ichicode'],\n  line_total: ['servicetotalamount', 'linetotal'], insurance_amount: ['insuranceamount'], denial_reason: ['denialreason']\n};\nconst pick = row => {\n  const m = {}; for (const [k, v] of Object.entries(row || {})) m[norm(k)] = v;\n  const o = {};\n  for (const [f, al] of Object.entries(ALIAS)) for (const a of al) {\n    if (m[a] !== undefined && m[a] !== null && String(m[a]).trim() !== '') { o[f] = m[a]; break; }\n  }\n  return o;\n};\nconst splitList = s => String(s ?? '').split(/;|\\n/).map(x => x.trim()).filter(Boolean);\nconst num = v => { const n = Number(String(v ?? '').replace(/,/g, '')); return Number.isFinite(n) ? n : 0; };\nconst hmac = s => crypto.createHmac('sha256', HMAC_SECRET).update(String(s)).digest('hex');\nconst PHI_RULES = [\n  [/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[EMAIL]'],\n  [/\\b\\d{14}\\b/g, '[NATIONAL_ID]'],\n  [/(?:\\+?20|0)?1[0125]\\d{8}\\b/g, '[PHONE]'],\n  [/\\b\\d{9,}\\b/g, '[NUMBER]']\n];\nconst scrub = (text, ids) => {\n  let t = latin(text);\n  for (const id of ids.filter(x => x && x.length > 2).sort((a, b) => b.length - a.length)) t = t.split(id).join('[REDACTED]');\n  for (const [r, v] of PHI_RULES) t = t.replace(r, v);\n  return t;\n};\nconst INJECTION = [\n  /ignore\\s+(all\\s+)?(the\\s+)?(previous|prior|above|earlier)\\s+(instructions|rules|prompts?)/i,\n  /disregard\\s+(all\\s+)?(the\\s+)?(previous|above|system|prior)/i,\n  /system\\s*prompt/i, /you\\s+are\\s+now\\s+/i, /approve\\s+(every|all)\\s+/i, /maximum\\s+price/i,\n  /<\\s*\\/?\\s*(system|instructions?|assistant)\\s*>/i, /تجاهل\\s+(كل\\s+|جميع\\s+)?(التعليمات|الأوامر)/\n];\nconst monthOf = v => {\n  const s = latin(v).trim(); if (!s) return '';\n  let m = s.match(/^(\\d{4})-(\\d{1,2})/); if (m) return m[1] + '-' + m[2].padStart(2, '0');\n  m = s.match(/^(\\d{1,2})[\\/\\-.](\\d{1,2})[\\/\\-.](\\d{4})/); if (m) return m[3] + '-' + m[2].padStart(2, '0');\n  const d = new Date(s); return isNaN(d) ? '' : d.toISOString().slice(0, 7);\n};\nconst groups = new Map();\nsrc.rows.forEach(raw => {\n  const r = pick(raw);\n  if (!r.service_code && !r.service_name && !r.dx_codes) return; // blank export rows\n  const enc = r.encounter_id || r.bill_no || ((r.patient_file_no || '') + '|' + (r.bill_date || ''));\n  const key = (r.facility_id || r.facility || '') + '|' + idStr(enc);\n  if (!groups.has(key)) groups.set(key, []);\n  groups.get(key).push(r);\n});\nconst now = new Date().toISOString();\nconst out = [];\nfor (const [key, lines] of groups) {\n  const h = lines[0];\n  const nid = idStr(h.national_id), pfn = idStr(h.patient_file_no);\n  const idSource = nid || pfn;\n  const claim_ref = 'CLM-' + hmac('claim|' + key).slice(0, 10).toUpperCase();\n  const patient_token = idSource ? 'PT-' + hmac('patient|' + idSource).slice(0, 16).toUpperCase() : 'PT-UNKNOWN';\n  const identifiers = [h.patient_name, ...String(h.patient_name || '').split(/\\s+/).filter(w => w.length >= 3), nid, pfn,\n    idStr(h.encounter_id), idStr(h.bill_no), idStr(h.visit_id), idStr(h.episode_id), h.practitioner_name]\n    .map(x => latin(x).trim()).filter(Boolean);\n  const codes = splitList(h.dx_codes), descs = splitList(h.dx_descs), types = splitList(h.dx_types);\n  const rawText = [...descs, ...lines.map(l => l.service_name || ''), ...lines.map(l => l.denial_reason || '')].join(' | ');\n  const diagnoses = codes.map((c, i) => ({ code: c, description: scrub(descs[i] || '', identifiers), type: /princ/i.test(types[i] || '') ? 'Principal' : (types[i] || (i === 0 ? 'Principal' : 'Secondary')) }));\n  if (!codes.length && descs.length) descs.forEach((d, i) => diagnoses.push({ code: '', description: scrub(d, identifiers), type: i === 0 ? 'Principal' : 'Secondary' }));\n  const principal = diagnoses.find(d => /princ/i.test(d.type)) || diagnoses[0] || { code: '', description: '' };\n  const billed_services = lines.map((l, i) => {\n    const qty = num(l.qty) || 1, total = num(l.line_total);\n    return { line_no: i + 1, service_code: String(l.service_code || '').trim(), ichi_code: String(l.ichi_code || '').trim(),\n      service_name: scrub(l.service_name || l.service_name_ar || '', identifiers), service_group: String(l.service_group || ''),\n      service_class: String(l.service_class || ''), qty, unit_price: +(total / qty).toFixed(2), line_total: +total.toFixed(2),\n      insurance_amount: +num(l.insurance_amount).toFixed(2) };\n  });\n  const scrubbedText = [...diagnoses.map(d => d.description), ...billed_services.map(s => s.service_name)].join(' | ');\n  const phi_masked = /\\[(REDACTED|EMAIL|NATIONAL_ID|PHONE|NUMBER)\\]/.test(scrubbedText);\n  const injection = INJECTION.some(r => r.test(rawText));\n  let status = 'ACCEPTED', status_reason = phi_masked ? 'Identifiers found in free text were masked' : '';\n  if (!idSource) { status = 'BLOCKED_NO_PATIENT_ID'; status_reason = 'Row has no National ID / Patient ID - cannot tokenise'; }\n  if (injection) { status = 'BLOCKED_INJECTION'; status_reason = 'Free text contains instruction-like content (possible prompt injection) - escalated to a human, not sent to any model'; }\n  const denial = scrub(lines.map(l => l.denial_reason).find(Boolean) || '', identifiers);\n  const practitioner_id = String(h.practitioner_id || '').trim();\n  const phi = { patient_name: h.patient_name || '', national_id: nid, patient_file_no: pfn, encounter_id: idStr(h.encounter_id),\n    episode_id: idStr(h.episode_id), visit_id: idStr(h.visit_id), bill_no: idStr(h.bill_no), bill_date: String(h.bill_date || ''),\n    practitioner_name: h.practitioner_name || '' };\n  const iv = crypto.randomBytes(12);\n  const c = crypto.createCipheriv('aes-256-gcm', KEY, iv);\n  const enc = Buffer.concat([c.update(JSON.stringify(phi), 'utf8'), c.final()]);\n  out.push({ json: {\n    claim: {\n      run_id: src.run_id, received_at: src.received_at, claim_ref, patient_token,\n      facility: String(h.facility || ''), encounter_type: String(h.encounter_type || ''), visit_type: String(h.visit_type || ''),\n      service_month: monthOf(h.bill_date), practitioner_id,\n      clinician_email: clin[practitioner_id] || String(cfg.default_reviewer_email || '').toLowerCase(),\n      diagnoses, principal_dx_code: principal.code, principal_dx_desc: principal.description,\n      billed_services, billed_total: +billed_services.reduce((a, s) => a + s.line_total, 0).toFixed(2),\n      denial_reason: denial, phi_masked\n    },\n    status, status_reason,\n    vault_row: idSource ? { claim_ref, patient_token, encrypted_payload: enc.toString('hex'), iv: iv.toString('hex'), auth_tag: c.getAuthTag().toString('hex'), created_at: now } : null\n  } });\n}\nif (!out.length) throw new Error('No usable claim lines found (check the column names match the Claim Service export)');\nreturn out;\n"
