      "parameters": {
        "jsCode": "// LangChain prompt templates treat curly braces as variables, so data is passed brace-free.\nconst braceSafe = s => String(s).replace(/\\{/g, '(').replace(/\\}/g, ')');\nconst c = $('W5 Input').first().json;\nconst pkg = {\n  claim_ref: c.claim_ref,\n  SOURCE_EVIDENCE: { principal_diagnosis: `${c.principal_dx_code} ${c.principal_dx_desc}`, payer_denial_reason: c.denial_reason || 'none',\n    billed_services: c.billed_services, protocol_rows: c.best_claim_services.map(s => ({ ref: s.ref, code: s.service_code, service: s.service_name, necessity: s.necessity, evidence_quote: s.evidence_quote })) },\n  OUTPUT_1_BEST_CLAIM: { protocol_match_found: c.protocol_match_found, matched_protocol: `${c.matched_protocol_id} ${c.matched_protocol_title}`,\n    decisions: c.best_claim_services.map(s => ({ code: s.service_code, service: s.service_name, decision: s.decision, reason: s.reason })), clinical_justification: c.clinical_justification },\n  OUTPUT_2_GAP_ANALYSIS: { totals_EGP: c.totals, gaps: c.gaps, denial_risk: c.denial_risk, narrative_en: c.gap_narrative_en, narrative_ar: c.gap_narrative_ar, recommended_actions: c.recommended_actions },\n  OUTPUT_3_LETTER: c.letter && c.letter.letter_en ? { type: c.letter.letter_type, subject: c.letter.subject, letter_en: c.letter.letter_en, letter_ar: c.letter.letter_ar, cited_refs: c.letter.cited_refs } : null\n};\nreturn [{ json: { prompt: braceSafe(`<evaluation_package>\\n${JSON.stringify(pkg)}\\n</evaluation_package>\\nScore OUTPUT_1 as BEST_CLAIM, OUTPUT_2 as GAP_ANALYSIS${pkg.OUTPUT_3_LETTER ? ' and OUTPUT_3 as LETTER' : ' (there is no letter - do not score LETTER)'}.`) } }];\n"
