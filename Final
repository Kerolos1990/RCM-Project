      "parameters": {
        "jsCode": "const d = $input.first().json;\nif (!d.authorized) return [{ json: { status_code: 403, html: '<h3>403 - add ?key=YOUR_RCM_DASHBOARD_KEY to the URL</h3>' } }];\nconst m = d.metrics;\nconst esc = t => String(t ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst fmt = (v, s = '') => v === null || v === undefined ? '—' : (typeof v === 'number' ? v.toLocaleString('en-US') : esc(v)) + s;\nconst card = (label, value, sub, tone) => `<div class=\"card ${tone || ''}\"><div class=\"lbl\">${label}</div><div class=\"val\">${value}</div><div class=\"sub\">${sub || ''}</div></div>`;\nconst actual = k => ({ avg_pipeline_minutes: fmt(m.avg_pipeline_minutes, ' min'), protocol_match_rate: fmt(m.protocol_match_rate, '%'), avg_safety: fmt(m.avg_safety), avg_groundedness: fmt(m.avg_groundedness),\n  blocked_inputs: fmt(m.blocked_inputs) + ' blocked', letters_drafted: fmt(m.letters_drafted) + ' drafted', potential_recovery: fmt(m.potential_recovery, ' EGP') }[k] ?? '—');\nconst bar = (v) => { const p = v === null ? 0 : Math.max(0, Math.min(100, v / 5 * 100)); const tone = v === null ? '' : v >= 4 ? 'ok' : v >= 3 ? 'warn' : 'bad'; return `<div class=\"bar\"><span class=\"${tone}\" style=\"width:${p}%\"></span></div>`; };\nconst dims = Object.entries(m.judge_avg).map(([k, v]) => `<tr><td>${k.replace('_', ' ')}</td><td class=\"num\">${fmt(v)}</td><td>${bar(v)}</td></tr>`).join('');\nconst kpiRows = d.kpis.map(k => `<tr><td>${esc(k.kpi)}</td><td>${esc(k.lens)}</td><td>${esc(k.baseline)}</td><td>${esc(k.target)}</td><td class=\"num\"><b>${actual(k.metric_key)}</b></td></tr>`).join('');\nconst gapRows = d.recent_gaps.map(g => `<tr><td>${esc(g.claim_ref)}</td><td>${esc(g.protocol)}</td><td><span class=\"pill ${String(g.risk).toLowerCase()}\">${esc(g.risk)}</span></td><td class=\"num\">${fmt(g.billed)}</td><td class=\"num\">${fmt(g.missing)}</td><td class=\"small\">${esc(g.flags)}</td></tr>`).join('') || '<tr><td colspan=\"6\">No claims yet</td></tr>';\nconst issues = d.recent_issues.map(r => `<tr><td class=\"small\">${esc(String(r.timestamp).slice(0, 16).replace('T', ' '))}</td><td>${esc(r.workflow)}</td><td>${esc(r.claim_ref)}</td><td>${esc(r.status)}</td><td class=\"small\">${esc(r.detail)}</td></tr>`).join('') || '<tr><td colspan=\"5\">No failed or escalated runs</td></tr>';\nconst alerts = d.recent_alerts.map(a => `<tr><td class=\"small\">${esc(String(a.timestamp).slice(0, 16).replace('T', ' '))}</td><td><span class=\"pill ${a.level === 'HARD' ? 'high' : 'medium'}\">${esc(a.level)}</span></td><td>${esc(a.metric)}</td><td class=\"num\">${esc(a.value)}</td><td class=\"small\">${esc(a.action)}</td></tr>`).join('') || '<tr><td colspan=\"5\">No alerts</td></tr>';\nconst so = Object.entries(m.signoffs).map(([k, v]) => `${esc(k)}: <b>${v}</b>`).join(' · ') || 'none yet';\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"refresh\" content=\"600\"><title>RCM AI Monitor</title>\n<style>:root{--bg:#f4f6f9;--card:#fff;--ink:#1d2433;--mute:#667085;--line:#e4e7ec;--navy:#1f3864;--ok:#1b7f3b;--warn:#b26a00;--bad:#b00020}\n@media (prefers-color-scheme:dark){:root{--bg:#0f141c;--card:#18202b;--ink:#e6e9ef;--mute:#9aa4b2;--line:#2a3442;--navy:#8fb3ff}}\nbody{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 system-ui,Segoe UI,Arial,sans-serif}.wrap{max-width:1180px;margin:0 auto;padding:20px 16px}\nh1{font-size:22px;margin:0}h2{font-size:15px;margin:26px 0 10px;color:var(--navy)}.top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap}\n.status{padding:6px 12px;border-radius:999px;font-weight:600;background:${m.paused ? 'var(--bad)' : 'var(--ok)'};color:#fff}.mute{color:var(--mute)}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px}\n.lbl{color:var(--mute);font-size:12px;text-transform:uppercase;letter-spacing:.04em}.val{font-size:26px;font-weight:700;margin-top:4px}.sub{color:var(--mute);font-size:12px}\n.card.bad .val{color:var(--bad)}.card.warn .val{color:var(--warn)}table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}\nth,td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{font-size:12px;color:var(--mute);font-weight:600}.num{text-align:right;font-variant-numeric:tabular-nums}\n.small{font-size:12px;color:var(--mute)}.bar{height:8px;background:var(--line);border-radius:4px;overflow:hidden;min-width:120px}.bar span{display:block;height:100%}.bar .ok{background:var(--ok)}.bar .warn{background:var(--warn)}.bar .bad{background:var(--bad)}\n.pill{padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600;color:#fff;background:#667085}.pill.high{background:var(--bad)}.pill.medium{background:var(--warn)}.pill.low{background:var(--ok)}\n.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:800px){.two{grid-template-columns:1fr}}.tw{overflow-x:auto}</style></head><body><div class=\"wrap\">\n<div class=\"top\"><div><h1>RCM AI · Smart Claims monitoring</h1><div class=\"mute\">لوحة متابعة نظام مراجعة المطالبات · updated ${esc(m.generated_at.slice(0, 16).replace('T', ' '))} UTC · auto-refresh 5 min</div></div><div class=\"status\">${m.paused ? 'PIPELINE PAUSED (hard alert)' : 'Pipeline running'}</div></div>\n<h2>Volume & value</h2><div class=\"grid\">\n${card('Claims received', fmt(m.claims_total), fmt(m.claims_24h) + ' in last 24h')}\n${card('Protocol match rate', fmt(m.protocol_match_rate, '%'), 'target ≥ 80%', m.protocol_match_rate !== null && m.protocol_match_rate < 80 ? 'warn' : '')}\n${card('Potential recovery', fmt(m.potential_recovery), 'EGP · mandatory services not billed (preliminary)')}\n${card('Denial risk value', fmt(m.denial_risk_value), 'EGP · extras + above-tariff', m.denial_risk_value > 0 ? 'warn' : '')}\n${card('High-risk claims', fmt(m.high_risk_claims), 'denial risk HIGH', m.high_risk_claims ? 'warn' : '')}\n${card('Letters drafted', fmt(m.letters_drafted), 'appeals + pre-submission memos')}\n</div>\n<h2>Safety & quality</h2><div class=\"grid\">\n${card('Escalations to humans', fmt(m.escalations), 'blocked inputs + no protocol + safety fails', m.escalations ? 'warn' : '')}\n${card('Blocked at PHI gate', fmt(m.blocked_inputs), 'never reached a model')}\n${card('Failed runs', fmt(m.failed_runs), fmt(m.failed_runs_24h) + ' in last 24h', m.failed_runs_24h ? 'bad' : '')}\n${card('Avg automation time', fmt(m.avg_pipeline_minutes, ' min'), 'intake → judged (per claim)')}\n${card('Judge safety (avg)', fmt(m.avg_safety), 'target ≥ 4.5 · soft alert < ' + esc(d.cfg.soft_safety_avg_threshold ?? 4), m.avg_safety !== null && m.avg_safety < 4 ? 'bad' : '')}\n${card('Clinician approvals', fmt(m.approved), so)}\n</div>\n<div class=\"two\"><div><h2>LLM-as-judge (${fmt(m.judged_outputs)} outputs scored, 1–5)</h2><table>${dims}</table></div>\n<div><h2>Alerts</h2><div class=\"tw\"><table><tr><th>Time</th><th>Level</th><th>Metric</th><th>Value</th><th>Action</th></tr>${alerts}</table></div></div></div>\n<h2>KPIs – target vs actual</h2><div class=\"tw\"><table><tr><th>KPI</th><th>Lens</th><th>Baseline</th><th>Target</th><th>Actual</th></tr>${kpiRows}</table></div>\n<h2>Latest claims</h2><div class=\"tw\"><table><tr><th>Claim</th><th>Protocol</th><th>Risk</th><th>Billed EGP</th><th>Missing EGP</th><th>Flags</th></tr>${gapRows}</table></div>\n<h2>Failed / escalated runs</h2><div class=\"tw\"><table><tr><th>Time</th><th>WF</th><th>Claim</th><th>Status</th><th>Detail</th></tr>${issues}</table></div>\n<p class=\"small\">Synthetic data only. Tokens only – no patient identifiers on this page. Figures are preliminary and require clinician and coder validation.</p></div></body></html>`;\nreturn [{ json: { status_code: 200, html } }];\n"
