        "jsCode": "// LangChain prompt templates treat curly braces as variables, so data is passed brace-free.\nconst braceSafe = s => String(s).replace(/\\{/g, '(').replace(/\\}/g, ')');\n// Decide which letter each claim needs. Tokens only from here until local re-identification.\nconst need = ['claim_ref', 'patient_token', 'gaps', 'totals', 'best_claim_services'];\nreturn $input.all().map(i => {\n  const c = i.json;\n  const miss = need.filter(k => c[k] === undefined);\n  if (miss.length) throw new Error('W4 input missing fields: ' + miss.join(', '));\n  const actionable = c.gaps.filter(g => ['MISSING_MANDATORY', 'PRICE_ABOVE_TARIFF', 'EXTRA_NOT_IN_PROTOCOL', 'NOT_ROUTINE_PER_PROTOCOL', 'DELETED_SERVICE_CODE'].includes(g.type));\n  let letter_type = 'NONE', letter_block = '';\n  if (!c.protocol_match_found) letter_block = c.denial_reason ? 'APPEAL_NEEDS_MANUAL_DRAFT (no approved protocol to cite)' : '';\n  else if (c.denial_reason) letter_type = 'APPEAL';\n  else if (actionable.length) letter_type = 'PRE_SUBMISSION_REVIEW_MEMO';\n  const citations = [...new Map(c.best_claim_services.map(s => [s.row_id, { ref: `${s.citation.protocol_id} / ${s.citation.source_file} p.${s.citation.source_pages}`, service_code: s.service_code, service: s.service_name, necessity: s.necessity, decision: s.decision, evidence_quote: s.citation.evidence_quote }])).values()];\n  const prompt = braceSafe(`<letter_request>\\nletter_type: ${letter_type}\\nclaim_ref: ${c.claim_ref}\\npatient_token: ${c.patient_token}\\nfacility: ${c.facility}\\nservice_month: ${c.service_month}\\nprincipal diagnosis: ${c.principal_dx_code} ${c.principal_dx_desc}\\nmatched protocol: ${c.matched_protocol_id} - ${c.matched_protocol_title}\\npayer denial reason: ${c.denial_reason || 'none (pre-submission review)'}\\n</letter_request>\\n<billed_services>\\n${JSON.stringify(c.billed_services.map(s => ({ code: s.service_code, name: s.service_name, qty: s.qty, total: s.line_total })))}\\n</billed_services>\\n<protocol_citations>\\n${JSON.stringify(citations)}\\n</protocol_citations>\\n<gaps>\\n${JSON.stringify(actionable)}\\n</gaps>\\n<clinical_justification_from_coding_agent>\\n${c.clinical_justification}\\n</clinical_justification_from_coding_agent>`);\n  const flags = [...c.review_flags]; if (letter_block) flags.push(letter_block);\n  return { json: { ...c, letter_type, needs_letter: letter_type !== 'NONE', allowed_refs: citations.map(x => x.ref), review_flags: [...new Set(flags)], prompt } };\n});\n"
