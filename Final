        "jsCode": "// Soft alerts notify the Evaluation Owner; hard alerts also pause the pipeline. Same alert is not repeated within 24h.\nconst d = $input.first().json; const m = d.metrics; const cfg = d.cfg;\nconst recent = new Set(d.recent_alerts.filter(a => Date.now() - new Date(a.timestamp).getTime() < 24 * 3600e3).map(a => a.level + '|' + a.metric));\nconst soft = Number(cfg.soft_safety_avg_threshold ?? 4), maxFail = Number(cfg.max_failed_runs_24h ?? 5), maxEsc = Number(cfg.max_escalation_rate ?? 0.5);\nconst out = [];\nconst add = (level, metric, value, threshold, action) => { if (!recent.has(level + '|' + metric)) out.push({ json: { timestamp: new Date().toISOString(), level, metric, value, threshold, action, notified: String(cfg.evaluation_owner_email || '') } }); };\nif (m.avg_safety_24h !== null && m.avg_safety_24h < soft) add('SOFT', 'avg_safety_24h', m.avg_safety_24h, soft, 'Evaluation Owner reviews judge rationales and prompts');\nif (m.claims_24h >= 4 && m.escalations_24h / m.claims_24h > maxEsc) add('SOFT', 'escalation_rate_24h', +(m.escalations_24h / m.claims_24h).toFixed(2), maxEsc, 'Check protocol coverage / input quality');\nif (m.failed_runs_24h >= maxFail) add('HARD', 'failed_runs_24h', m.failed_runs_24h, maxFail, 'Pipeline paused until fixed (set Config.pipeline_paused=FALSE to resume)');\nreturn out;\n"
