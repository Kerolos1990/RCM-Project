      "parameters": {
        "jsCode": "// LangChain prompt templates treat curly braces as variables, so data is passed brace-free.\nconst braceSafe = s => String(s).replace(/\\{/g, '(').replace(/\\}/g, ')');\n// RAG retrieval over the approved guideline tables (Protocols + Protocol_Services from CLINCAL GUIDELINES FINAL).\nconst claims = $('W2 Input').all().map(i => i.json);\nconst protocols = $('Read Protocols').all().map(i => i.json).filter(p => p.protocol_id);\nconst services = $('Read Protocol Services').all().map(i => i.json).filter(s => s.protocol_id);\nconst byProt = {};\nfor (const s of services) (byProt[s.protocol_id] = byProt[s.protocol_id] || []).push(s);\nconst SYN = [[/anaemi/g, 'anemi'], [/haem/g, 'hem'], [/caesar/g, 'cesar'], [/oedema/g, 'edema'], [/paediatr/g, 'pediatr'], [/diabetic ketoacidosis/g, 'dka diabetic ketoacidosis'], [/oesoph/g, 'esoph']];\nconst STOP = new Set(['unspecified', 'with', 'without', 'of', 'the', 'and', 'or', 'in', 'to', 'due', 'other', 'not', 'elsewhere', 'classified', 'nos', 'by', 'single', 'state', 'organism', 'type', 'see', 'notes', 'management', 'eha', 'medical', 'counseling', 'board', 'protocol', 'guideline', 'guidelines', 'disease', 'disorder', 'for', 'a', 'an', 'adult', 'adults', 'patient', 'patients', 'localised', 'generalised', 'localized', 'generalized']);\nconst toks = s => { let t = String(s || '').toLowerCase(); for (const [r, v] of SYN) t = t.replace(r, v);\n  return t.replace(/[^a-z0-9 ]+/g, ' ').split(/\\s+/).filter(w => w.length > 2 && !STOP.has(w)).map(w => w.replace(/(ies|es|s)$/, '')); };\nconst PED = /pediatr|picu|nicu|neonat|child/i, OBS = /obstet|gyn|obgy|pregnan/i;\nconst pIndex = protocols.map(p => ({ p, t: new Set(toks(p.diagnosis + ' ' + p.document_title)) })).filter(x => x.t.size);\nconst necRank = { mandatory: 0, conditional: 1, optional: 2 };\nreturn claims.map(c => {\n  const text = c.diagnoses.map(d => d.description).join(' ').toLowerCase();\n  const childCtx = /child|infant|neonat|pediatr|paediatr/.test(text), obsCtx = /pregnan|delivery|caesar|cesar|obstet|labou?r|puerper/.test(text);\n  const scored = pIndex.map(({ p, t }) => {\n    let score = 0;\n    c.diagnoses.forEach(d => {\n      const dt = new Set(toks(d.description)); if (!dt.size) return;\n      let hit = 0; for (const w of t) if (dt.has(w)) hit++;\n      const s = hit / t.size; score += (/princ/i.test(d.type) ? 2 : 1) * s;\n    });\n    if (PED.test(p.specialty + ' ' + p.protocol_id) && !childCtx) score *= 0.5;\n    if (OBS.test(p.specialty + ' ' + p.protocol_id) && !obsCtx) score *= 0.6;\n    return { p, score };\n  }).filter(x => x.score >= 0.6).sort((a, b) => b.score - a.score).slice(0, 3);\n  const billedCodes = new Set(c.billed_services.flatMap(s => [s.service_code, s.ichi_code]).filter(Boolean));\n  const billedNames = c.billed_services.map(s => String(s.service_name || '').toLowerCase()).join(' | ');\n  const GENERIC = new Set(['unspecified', 'solution', 'infusion', 'systemic', 'injection', 'tablet', 'therapy', 'regular', 'normal']);\n  const drugBilled = s => /medication/i.test(s.category || '') && String(s.service_name || '').toLowerCase().replace(/[^a-z ]/g, ' ').split(/\\s+/).some(w => w.length >= 5 && !GENERIC.has(w) && billedNames.includes(w));\n  const candidates = scored.map(({ p, score }) => ({\n    protocol_id: p.protocol_id, specialty: p.specialty, diagnosis: p.diagnosis, document_title: p.document_title,\n    source_file: p.source_file, validation_status: p.validation_status, retrieval_score: +score.toFixed(2),\n    services: (byProt[p.protocol_id] || []).slice().sort((a, b) => (necRank[a.necessity] ?? 3) - (necRank[b.necessity] ?? 3)).slice(0, 45).map(s => ({\n      row_id: s.row_id, category: s.category, service_name: s.service_name, service_code: s.service_code || '', ichi_code: s.ichi_code || '',\n      necessity: s.necessity, condition: s.condition || '', negative_statement: s.negative_statement || 'No', price_egp: s.price_egp ?? '',\n      mapping_confidence: s.mapping_confidence || '', evidence_quote: s.evidence_quote || '', source_file: s.source_file || '', source_pages: String(s.source_pages ?? ''),\n      billed: !!((s.service_code && billedCodes.has(s.service_code)) || (s.ichi_code && billedCodes.has(s.ichi_code)) || drugBilled(s))\n    }))\n  }));\n  const protText = candidates.length ? candidates.map(cp => `PROTOCOL ${cp.protocol_id} | ${cp.specialty} | ${cp.diagnosis} | file: ${cp.source_file} | retrieval_score ${cp.retrieval_score}\\n` +\n    cp.services.map(s => `- row_id=${s.row_id} | ${s.category} | ${s.service_name} | code=${s.service_code || 'NONE'} | necessity=${s.necessity} | condition=${s.condition || '-'} | not_routine=${s.negative_statement} | billed=${s.billed ? 'YES' : 'no'} | pages=${s.source_pages} | evidence=\"${String(s.evidence_quote).slice(0, 160)}\"`).join('\\n')).join('\\n\\n')\n    : 'NO APPROVED PROTOCOL WAS RETRIEVED FOR THIS CLAIM.';\n  const claimText = JSON.stringify({ claim_ref: c.claim_ref, patient_token: c.patient_token, encounter_type: c.encounter_type,\n    diagnoses: c.diagnoses, billed_services: c.billed_services.map(s => ({ line_no: s.line_no, code: s.service_code, ichi: s.ichi_code, name: s.service_name, group: s.service_group, qty: s.qty })),\n    denial_reason: c.denial_reason || '' });\n  return { json: { ...c, candidates,\n    prompt: braceSafe(`<claim_data>\\n${claimText}\\n</claim_data>\\n\\n<approved_protocols>\\n${protText}\\n</approved_protocols>\\n\\nReturn the Best Claim decision for claim_ref ${c.claim_ref}.`) } };\n});\n"
