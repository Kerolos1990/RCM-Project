        "jsCode": "// Test Sign-off Form -> rebuild the tokens-only W5 package for one claim from the system sheets.\nconst f = $('Test Sign-off Form').first().json;\nconst want = String(f['Claim Ref'] || '').trim().toUpperCase();\nconst rows = n => $(n).all().map(i => i.json).filter(r => r && r.claim_ref);\nconst claims = rows('Form: Read Claims'), best = rows('Form: Read Best Claim'), gaps = rows('Form: Read Gap Report'),\n  letters = rows('Form: Read Appeals'), billed = rows('Form: Read Original Billed');\nconst g = want ? gaps.find(r => String(r.claim_ref).trim().toUpperCase() === want) : gaps[gaps.length - 1];\nif (!g) throw new Error(want ? `Claim ${want} was not found in Gap_Report. Copy a claim_ref from the Gap_Report tab, or leave the field empty for the latest claim.` : 'Gap_Report is empty - run the pipeline once (Manual Test or upload) before testing the sign-off.');\nconst ref = g.claim_ref;\nconst c = claims.find(r => r.claim_ref === ref) || {};\nconst b = best.find(r => r.claim_ref === ref) || {};\nconst l = letters.find(r => r.claim_ref === ref);\nconst J = (s, d) => { try { return JSON.parse(s); } catch (e) { return d; } };\nconst T = v => v === true || String(v).trim().toUpperCase() === 'TRUE';\nconst N = v => Number(String(v ?? '').replace(/,/g, '')) || 0;\nconst svc = J(b.best_claim_services_json, []);\nconst cites = J(b.citations_json, []);\nconst email = String(f['Send review email to'] || '').trim() || String(c.clinician_email || '').trim();\nreturn [{ json: {\n  run_id: c.run_id || g.run_id || '', received_at: new Date().toISOString(), claim_ref: ref, patient_token: g.patient_token || c.patient_token,\n  clinician_email: email, facility: c.facility || '', service_month: c.service_month || '',\n  principal_dx_code: c.principal_dx_code || b.principal_dx_code || '', principal_dx_desc: c.principal_dx_desc || b.principal_dx_desc || '',\n  denial_reason: c.denial_reason || '', protocol_match_found: T(b.protocol_match_found),\n  matched_protocol_id: b.matched_protocol_id || g.matched_protocol_id || '', matched_protocol_title: b.matched_protocol_title || '',\n  clinical_justification: b.clinical_justification || '',\n  billed_services: billed.filter(r => r.claim_ref === ref).map(r => ({ code: r.service_code, name: r.service_name, qty: N(r.qty), total: N(r.line_total) })),\n  best_claim_services: svc.map(s => ({ row_id: s.row_id, service_code: s.code || '', service_name: s.name || '', necessity: s.necessity || '', decision: s.decision || '',\n    reason: '', ref: cites[0] || b.matched_protocol_id || '', evidence_quote: '' })),\n  gaps: J(g.gaps_json, []),\n  totals: { billed_total: N(g.billed_total), billed_at_tariff: N(g.billed_at_tariff), best_claim_total: N(g.best_claim_total), missing_value: N(g.missing_value),\n    extra_value_at_risk: N(g.extra_value_at_risk), price_variance_total: N(g.price_variance_total) },\n  denial_risk: g.denial_risk || '', gap_narrative_en: g.gap_narrative_en || '', gap_narrative_ar: g.gap_narrative_ar || '',\n  recommended_actions: String(g.recommended_actions || '').split(' | ').filter(Boolean),\n  letter: l ? { claim_ref: ref, patient_token: l.patient_token, letter_type: l.letter_type, subject: l.subject, letter_en: l.letter_en, letter_ar: l.letter_ar, cited_refs: l.cited_refs, letter_flags: l.letter_flags } : null,\n  review_flags: String(g.review_flags || '').split(';').filter(Boolean), accounting_status: 'FROM_TEST_FORM' } }];\n"
