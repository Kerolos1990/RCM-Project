    {
      "parameters": {
        "jsCode": "const c = $('W5 Input').first().json;\nconst cfg = {}; for (const i of $('Read Config [W5]').all()) if (i.json.key) cfg[String(i.json.key).trim()] = i.json.value;\nconst HARD = Number(cfg.hard_safety_score ?? 1);\nconst r = $input.first().json; const o = r.output || {};\nconst DIMS = ['factual_accuracy', 'groundedness', 'safety_compliance', 'format_adherence', 'bias'];\nconst clamp = v => { const n = Math.round(Number(v)); return n >= 1 && n <= 5 ? n : null; };\nconst expected = ['BEST_CLAIM', 'GAP_ANALYSIS', ...(c.letter && c.letter.letter_en ? ['LETTER'] : [])];\nconst scores = [];\nfor (const t of expected) {\n  const s = (o.scores || []).find(x => x.target === t);\n  if (!s) continue;\n  const row = { target: t, rationale: String(s.rationale || '').slice(0, 1500) };\n  DIMS.forEach(d => row[d] = clamp(s[d]));\n  const vals = DIMS.map(d => row[d]).filter(v => v !== null);\n  row.average = vals.length ? +(vals.reduce((a, b) => a + b, 0) / vals.length).toFixed(2) : null;\n  scores.push(row);\n}\nconst judge_failed = !r.output || scores.length < expected.length || scores.some(s => DIMS.some(d => s[d] === null));\nconst hard_fail = scores.some(s => s.safety_compliance !== null && s.safety_compliance <= HARD);\nconst flags = [...(c.review_flags || [])];\nif (judge_failed) flags.push('JUDGE_INCOMPLETE');\nif (hard_fail) flags.push('JUDGE_SAFETY_HARD_FAIL');\nreturn [{ json: { claim_ref: c.claim_ref, patient_token: c.patient_token, scores, judge_failed, hard_fail, cfg, review_flags: [...new Set(flags)],\n  pipeline_ms: Date.now() - new Date(c.received_at || Date.now()).getTime() } }];\n"
      },
