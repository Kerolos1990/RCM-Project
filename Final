      "parameters": {
        "jsCode": "// Monitoring metrics from the system sheets. Used by the hourly alert check and by the dashboard page.\nconst rows = n => $(n).all().map(i => i.json).filter(r => r && Object.keys(r).some(k => k !== 'row_number' && r[k] !== '' && r[k] !== undefined && r[k] !== null));\nconst cfg = {}; for (const r of rows('Read Config (mon)')) cfg[String(r.key).trim()] = r.value;\nconst claims = rows('Read Claims'), best = rows('Read Best Claim'), gaps = rows('Read Gap Report'), judge = rows('Read Judge Scores'),\n  runs = rows('Read Run Log'), signs = rows('Read Signoffs'), appeals = rows('Read Appeals'), kpis = rows('Read KPI Targets'), alerts = rows('Read Alerts');\nconst isDash = $('Dashboard Request').isExecuted;\nlet authorized = true;\nif (isDash) { const q = $('Dashboard Request').first().json.query || {}; const key = 'RCM2030'; authorized = String(q.key || '').trim() === key; }\nconst T = v => v === true || String(v).trim().toUpperCase() === 'TRUE';\nconst N = v => { if (v === '' || v === null || v === undefined) return null; const n = Number(String(v).replace(/,/g, '')); return Number.isFinite(n) ? n : null; };\nconst avg = a => { const v = a.map(N).filter(x => x !== null); return v.length ? +(v.reduce((x, y) => x + y, 0) / v.length).toFixed(2) : null; };\nconst since = (r, f, h) => { const t = new Date(r[f]).getTime(); return Number.isFinite(t) && Date.now() - t <= h * 3600e3; };\nconst real = judge.filter(j => j.target !== 'JUDGE_FAILED');\nconst DIMS = ['factual_accuracy', 'groundedness', 'safety_compliance', 'format_adherence', 'bias'];\nconst judgeAvg = Object.fromEntries(DIMS.map(d => [d, avg(real.map(j => j[d]))]));\nconst j24 = real.filter(j => since(j, 'created_at', 24));\nconst blocked = claims.filter(c => String(c.status || '').startsWith('BLOCKED'));\nconst noMatch = best.filter(b => !T(b.protocol_match_found));\nconst sum = (a, f) => +a.reduce((x, r) => x + (N(r[f]) || 0), 0).toFixed(2);\nconst pipeline = runs.filter(r => r.step === 'W5_JUDGE' && N(r.duration_ms) !== null);\nconst byStatus = {}; for (const s of signs) byStatus[s.db_status] = (byStatus[s.db_status] || 0) + 1;\nconst m = {\n  generated_at: new Date().toISOString(), paused: T(cfg.pipeline_paused),\n  claims_total: claims.length, claims_accepted: claims.length - blocked.length, blocked_inputs: blocked.length,\n  protocol_match_rate: best.length ? +((best.length - noMatch.length) / best.length * 100).toFixed(1) : null,\n  escalations: blocked.length + noMatch.length + real.filter(j => N(j.safety_compliance) !== null && N(j.safety_compliance) <= N(cfg.hard_safety_score ?? 1)).length,\n  avg_pipeline_minutes: pipeline.length ? +(avg(pipeline.map(r => r.duration_ms)) / 60000).toFixed(2) : null,\n  judge_avg: judgeAvg, avg_safety: judgeAvg.safety_compliance, avg_groundedness: judgeAvg.groundedness,\n  avg_safety_24h: avg(j24.map(j => j.safety_compliance)), safety_fails: real.filter(j => N(j.safety_compliance) !== null && N(j.safety_compliance) <= 2).length,\n  failed_runs: runs.filter(r => r.status === 'FAILED').length, failed_runs_24h: runs.filter(r => r.status === 'FAILED' && since(r, 'timestamp', 24)).length,\n  claims_24h: claims.filter(c => since(c, 'created_at', 24)).length, escalations_24h: claims.filter(c => since(c, 'created_at', 24) && String(c.status || '').startsWith('BLOCKED')).length + noMatch.filter(b => since(b, 'created_at', 24)).length,\n  potential_recovery: sum(gaps, 'missing_value'), denial_risk_value: +(sum(gaps, 'extra_value_at_risk') + sum(gaps, 'price_variance_total')).toFixed(2),\n  billed_total: sum(gaps, 'billed_total'), high_risk_claims: gaps.filter(g => g.denial_risk === 'HIGH').length,\n  letters_drafted: appeals.filter(a => a.letter_en && !String(a.letter_en).startsWith('[blocked')).length, signoffs: byStatus,\n  approved: byStatus.APPROVED_FOR_SUBMISSION || 0, judged_outputs: real.length\n};\nconst recentGaps = gaps.slice(-12).reverse().map(g => ({ claim_ref: g.claim_ref, protocol: g.matched_protocol_id, risk: g.denial_risk, billed: N(g.billed_total), missing: N(g.missing_value), flags: g.review_flags }));\nconst recentRuns = runs.filter(r => r.status === 'FAILED' || r.status === 'ESCALATED').slice(-10).reverse();\nreturn [{ json: { is_dashboard: isDash, authorized, metrics: m, cfg, kpis, recent_gaps: recentGaps, recent_issues: recentRuns, recent_alerts: alerts.slice(-8).reverse() } }];"
